# Copy to .env. Never commit real values.

# Postgres app connection string (percent-encode password specials: npm run database-url)
DATABASE_URL=postgres://second_brain:second_brain@127.0.0.1:55432/second_brain

# Argon2id hash of the login password (npm run hash-password)
AUTH_PASSWORD_HASH=

# Optional: session lifetime in days (default 30)
# SESSION_TTL_DAYS=30

# Attachment storage directory (default .data/attachments)
# ATTACHMENTS_DIR=

# TypeSafe Jev (optional). Enables tag / class suggestions on inbox items and AI rerank.
# The app works fully without it.
TYPESAFE_API_KEY=
# TYPESAFE_JEV_MODEL=jev-latest

# Chat model via Codex ChatGPT auth ($CODEX_HOME/auth.json or ~/.codex/auth.json). Optional.
# CODEX_HOME=
# CODEX_MODEL=gpt-5.4-mini
# CODEX_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex

# Proxy hops to trust for client IP (1 = Traefik only)
# TRUSTED_PROXY_HOPS=1
