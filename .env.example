# Copy to .env locally. Never commit real values.
# All secrets stay in the environment (E1-S3).

# Postgres (Compose service `db`)
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# App connection string. Percent-encode #, @, and other special characters in the password.
# Build from POSTGRES_APP_PASSWORD (Compose / local):
#   export DATABASE_URL="$(node scripts/build-database-url.mjs db 5432 second_brain)"
# Port-forward: node scripts/build-database-url.mjs 127.0.0.1 5432 second_brain
# Do not paste the raw password into the URL without encoding (e.g. # breaks URL parsing).
DATABASE_URL=

# Argon2id hash of the gate password. Not the password itself.
# Generate: npm run hash-password
AUTH_PASSWORD_HASH=

# Optional legacy / future signing (opaque cookie + DB hash is canonical).
SESSION_SECRET=

# Middleware session loopback (Edge cannot import pg). Default: http://127.0.0.1:3000
# INTERNAL_APP_URL=http://127.0.0.1:3000

# Edge: 1 = Traefik only (default). 2 = Cloudflare + Traefik.
# TRUSTED_PROXY_HOPS=1

# Optional rate/session tuning (defaults: 5 fails / 15m window / 15m lock / 5 sessions / 7d TTL)
# AUTH_FAIL_LIMIT=5
# AUTH_FAIL_WINDOW_MIN=15
# AUTH_LOCK_MIN=15
# AUTH_MAX_SESSIONS=5
# AUTH_SESSION_TTL_DAYS=7

# Optional. Defaults to production cookie flags (Secure).
# NODE_ENV=production

# Note attachments (E2). Local dir when unset: .data/attachments
# ATTACHMENTS_DIR=

# TypeSafe / Jev (Ada epic-wide). Console: console.typesafe.ai/settings/keys
# Required for capture/share tag suggestions + duplicate hints (Rex server sink).
# Kai client seat: src/lib/jev (typed boundary; Rex wires System One HTTP/SDK).
TYPESAFE_API_KEY=
# Production key. Identical to TYPESAFE_API_KEY is treated as misconfigured.
# TYPESAFE_PROD_API_KEY=
# Optional overrides: TYPESAFE_BASE_URL, TYPESAFE_DEFAULT_MODEL, TYPESAFE_LOG_LEVEL
# TYPESAFE_JEV_MODEL=jev-latest

# Chat generation (Codex-auth GPT). Server-side only. Absent key → 502 codex_failed.
# CODEX_API_KEY=
# OPENAI_API_KEY=
# CODEX_BASE_URL=https://api.openai.com/v1
# CODEX_MODEL=gpt-4.1
# CHAT_MAX_NOTES=10
# CHAT_MAX_CONTEXT_TOKENS=32000
# AI_LOG_TTL_DAYS=7
